NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
POSTGRES_USER=choose-a-database-user
POSTGRES_PASSWORD=generate-a-strong-random-password
POSTGRES_DB=beakohost
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/beakohost
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
# Produção usa /etc/beakohost/secrets/env-master-key. Este fallback é apenas para desenvolvimento local.
ENCRYPTION_MASTER_KEY=replace-with-32-byte-base64-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://bots.beako.fun/api/auth/discord/callback
AGENT_ENROLLMENT_SECRET=replace-with-a-random-enrollment-secret

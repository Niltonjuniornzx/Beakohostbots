[Unit]
Description=BeakoHost Runner Agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=beako-agent
Group=beako-agent
EnvironmentFile=/etc/beakohost/agent.env
ExecStart=/usr/local/bin/beako-runner
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/beakohost
ProtectHome=true

[Install]
WantedBy=multi-user.target
